<?xml version="1.0" encoding="utf-8"?>
<!--
  ويدجت «نور المسلم» الواحدة (alpha57 — بلاغ المالك: «خليها ويدجت
  واحده و قابلة للتخصيص بالكامل») — كل العناصر فيها بيتٌ مستقل يخفيه
  الرسّام من الإعدادات: الساعة الحيّة، التاريخان، الصلاة القادمة
  والعدّاد، مواقيت الصلوات الست (كلُّ خليةٍ فوق فقاعةٍ سائلة تُلوَّن
  لتحديد القادمة والحالية)، والمسبحة.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- الصف ١: العلامة والمدينة والساعة الحيّة -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_brand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="نور المسلم"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_city"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextClock
                android:id="@+id/widget_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- الصف ٢: التاريخان الهجري والميلادي -->
        <TextView
            android:id="@+id/widget_date_hijri"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_date_greg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- الصف ٣: الصلاة القادمة ووقتها والعدّاد — العدّاد فوق فقاعته -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/widget_next_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="21sp"
                        android:textStyle="bold"
                        android:maxLines="1" />

                    <TextView
                        android:id="@+id/widget_next_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:maxLines="1" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp">

                    <ImageView
                        android:id="@+id/widget_bubble_countdown"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_bubble"
                        android:contentDescription="@null" />

                    <Chronometer
                        android:id="@+id/widget_countdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="14dp"
                        android:textSize="12sp"
                        android:countDown="true" />
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- الصف ٤: مواقيت الصلوات الست — كل خليةٍ فوق فقاعتها -->
        <LinearLayout
            android:id="@+id/grid_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/widget_bubble_p0"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_bubble"
                    android:contentDescription="@null" />

                <LinearLayout style="@style/WidgetPrayerCell">
                    <TextView android:id="@+id/widget_pname_0" style="@style/WidgetPrayerName" />
                    <TextView android:id="@+id/widget_ptime_0" style="@style/WidgetPrayerTime" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/widget_bubble_p1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_bubble"
                    android:contentDescription="@null" />

                <LinearLayout style="@style/WidgetPrayerCell">
                    <TextView android:id="@+id/widget_pname_1" style="@style/WidgetPrayerName" />
                    <TextView android:id="@+id/widget_ptime_1" style="@style/WidgetPrayerTime" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/widget_bubble_p2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_bubble"
                    android:contentDescription="@null" />

                <LinearLayout style="@style/WidgetPrayerCell">
                    <TextView android:id="@+id/widget_pname_2" style="@style/WidgetPrayerName" />
                    <TextView android:id="@+id/widget_ptime_2" style="@style/WidgetPrayerTime" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/widget_bubble_p3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_bubble"
                    android:contentDescription="@null" />

                <LinearLayout style="@style/WidgetPrayerCell">
                    <TextView android:id="@+id/widget_pname_3" style="@style/WidgetPrayerName" />
                    <TextView android:id="@+id/widget_ptime_3" style="@style/WidgetPrayerTime" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/widget_bubble_p4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_bubble"
                    android:contentDescription="@null" />

                <LinearLayout style="@style/WidgetPrayerCell">
                    <TextView android:id="@+id/widget_pname_4" style="@style/WidgetPrayerName" />
                    <TextView android:id="@+id/widget_ptime_4" style="@style/WidgetPrayerTime" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/widget_bubble_p5"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_bubble"
                    android:contentDescription="@null" />

                <LinearLayout style="@style/WidgetPrayerCell">
                    <TextView android:id="@+id/widget_pname_5" style="@style/WidgetPrayerName" />
                    <TextView android:id="@+id/widget_ptime_5" style="@style/WidgetPrayerTime" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- الصف ٥: المسبحة — العدّ وزرا التسبيح والتصفير -->
        <LinearLayout
            android:id="@+id/widget_misbaha_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_misbaha_count"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_misbaha_tap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="14dp"
                android:paddingVertical="4dp"
                android:text="سبِّح"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_misbaha_reset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="تصفير"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
