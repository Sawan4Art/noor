<?xml version="1.0" encoding="utf-8"?>
<!--
  ويدجت «نور المسلم» الواحدة (alpha57 — بلاغ المالك: «خليها ويدجت
  واحده و قابلة للتخصيص بالكامل») — من alpha61 صارت العناصر تُبنى
  وقت الرسم: هذا الملف حاضنةٌ خلفيةٌ وعُلبةُ صفٍّ فارغة (widget_stack)
  يضيف إليها الرسّام عناصر الويدجت بأشكالها المستقلة
  (widget_el_header/clock/hijri/greg/next/countdown/grid/misbaha)
  بترتيب المستخدم المختار من المحرر التفاعلي — «قابل لتحريك كل
  العناصر» — فالترتيب حرٌّ والمخفي لا يُضاف أصلاً فلا فراغ مكانه.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/widget_stack"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp" />
</FrameLayout>
