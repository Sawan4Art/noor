<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".NoorApplication"
        android:allowBackup="true"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Noor">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:theme="@style/Theme.Noor">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          مكونات المنبه (تجهيز مرحلة الأذان بطلب المالك 2026-11-03):
          «وكمان سجل المكونات دي (AlarmActivity, BootReceiver, AlarmService)
          بالخصائص المطلوبة لتشغيل الشاشة فوق القفل والصوت في الخلفية».
          المكونات موجودة ومسجلة بخصائصها الكاملة من اليوم، وبلا أي
          سلوك تشغيلي حتى تُبنى مرحلة الأذان عليها:

          • AlarmActivity — شاشة التنبيه فوق القفل:
            showWhenLocked/turnScreenOn (٢٧+) وأعلام النافذة المكافئة
            داخلها للأقدم (٢٤-٢٦)، وبلا إدخال خارجي (exported=false).
          • BootReceiver — إقلاع الجهاز: إعادة جدولة منبهات الصلوات
            لاحقاً؛ exported=true إلزامي لاستقبال بث النظام المحمي.
          • AlarmService — خدمة أمامية بنوع mediaPlayback كي يعمل
            صوت الأذان والشاشة مطفأة (٢٨+) وبلا إدخال خارجي.
        -->
        <activity
            android:name=".alarm.AlarmActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:theme="@style/Theme.Noor"
            android:turnScreenOn="true" />

        <receiver
            android:name=".alarm.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- مستقبِل منبهات الأذان: يدق في وقته (أذان/إقامة/استعادة كتم/تجديد يومي) -->
        <receiver
            android:name=".alarm.AdhanAlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <!--
          ويدجتات النظام الخمسة (alpha56 — توجيه المالك: «خمس اشكال
          مختلفه بنفس تصميم التطبيق و قابله للتخصيص والتعديل الكامل»):
          كلٌّ شكل مستقل يستدلِيه المستخدم من قائمة ويدجتات النظام،
          والتخصيص المشترك يُقرأ عند كل رسم من مخزن الويدجت.
        -->
        <!--
          ويدجت «نور المسلم» الواحدة (alpha57 — بلاغ المالك: «خليها
          ويدجت واحده و قابلة للتخصيص بالكامل من الاعدادات») — مستقبل
          واحد: يرسم من التخصيص الحي ويستقبل بثّي المسبحة (تسبيح/تصفير).
        -->
        <receiver
            android:name=".widget.NoorWidget"
            android:enabled="true"
            android:exported="false"
            android:label="@string/widget_main_desc">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_main_info" />
        </receiver>

        <service
            android:name=".alarm.AlarmService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!--
          خدمة تنزيل أصوات التلاوة (alpha57 — بلاغ المالك: «تحميل اصوات
          الشيوخ مش شغال»): خدمة أمامية بنوع dataSync تُبقي العملية حية
          ما دام تنزيلٌ جارٍ فلا يموت التنزيل بإغلاق التطبيق من الريسنتس
          أو نوم الجهاز في التوفير، بإشعارٍ حيّ بنسبة التقدم.
        -->
        <service
            android:name=".data.mushaf.QuranDownloadService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
          موفّر الملفات عاد (alpha48): التثبيت الداخلي للتحديث رجع بأمر
          المالك «التحديث بقا يفتح المتصفح انا مش عايز كده» — بأسلم
          طريق: التنزيل بمدير تنزيل النظام نفسه والفتح بمثبّت أندرويد
          الرسمي عبر هذا الموفّر على ملف النسخة داخل ملفات التطبيق فقط.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!--
      حزمة الأذونات الكاملة (بطلب المالك 2026-10-30) — كل ميزة قادمة تجد إذنها جاهزاً:
      • الموقع + الإنترنت: حساب المواقيت وتحديد المدينة (يُطلبان وقتياً حوارات النظام)
      • الإشعارات: تنبيهات الأذان والأذكار (يُطلب وقتياً على 13+ بسلسلة الحوارات)
      • المنبهات الدقيقة: مواعيد الأذان بالثانية — USE_EXACT_ALARM منح تلقائياً
        لتطبيق مواقيت/تنبيهات (33+)، وSCHEDULE_EXACT_ALARM للأجهزة الأقدم (31-32)
      • الإقلاع: إعادة جدولة التنبيهات بعد إعادة تشغيل الجهاز
      • الاهتزاز والاستيقاظ: تنبيه الأذان والسبحة
      • الخدمة الأمامية للتشغيل: صوت الأذان يعمل والشاشة مطفأة (بميزة الأذان)
      • الوسائط الصوتية: اختيار صوت أذان مخصص من الجهاز (33+ وقديمها)
      • (alpha48) إذن تثبيت التحديثات REQUEST_INSTALL_PACKAGES عاد —
        التحديث رجع من داخل التطبيق بأمر المالك (بلا متصفح)، والطريق
        القياسي الآمن: تنزيل بمدير النظام + مثبّت أندرويد الرسمي،
        والإذن يُطلَب من المستخدم مرة واحدة في صفحة «المصادر غير
        المعروفة» قبل أول تنزيل
      الممنوح تلقائياً يُصرَّح به في المانيفست فقط، وحوارات النظام تُطلق عند أول
      حاجة فعلية للميزة (سلسلة الحوارات المتتابعة في MainActivity قائمة).
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- نافذة التنبيه كاملة الشاشة فوق القفل (الأذان) — إذن عادي ممنوح تثبيتاً -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- إشعال الشاشة من شاشة التنبيه على أندرويد 14+ (٣٤+) — مكمل turnScreenOn -->
    <uses-permission android:name="android.permission.TURN_SCREEN_ON" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- خدمة تنزيل أصوات التلاوة الأمامية (alpha57) — النوع المطلوب على ٣٤+ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!--
      عدم الإزعاج (alpha49 — توجيه المالك «امنح التطبيق اذونات عدم الازعاج»):
      كتم أصوات الهاتف كاملاً بعد الإقامة بمفتاح عدم الإزعاج نفسه،
      الإذن معلن هنا ويُمنح من صفحة النظام الخاصة به ضمن سلسلة
      الصلاحيات (أول تشغيل + بعد كل تحديث).
    -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!--
      إذن التثبيت (alpha48): التحديث من داخل التطبيق رجع بأمر المالك —
      التنزيل بمدير تنزيل النظام والفتح بمثبّت أندرويد الرسمي، والإذن
      يُطلب من المستخدم مرة واحدة قبل أول تنزيل في صفحة النظام نفسها.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!--
      استثناء من قتل البطارية — كفاءة المواقيت والأذان: كثير من هواتف
      الشركات تقتل المنبهات الدقيقة والخدمة الأمامية في وضع التوفير الشديد
      (بلاغات مستخدمي تطبيقات المواقيت أشهر أسباب فوات الأذان). الإذن عادي
      والحوار يُطلب وقتياً عند تفعيل الأذان فقط ولا يُفرض على أحد.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
</manifest>
