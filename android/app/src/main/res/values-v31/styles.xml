<?xml version="1.0" encoding="utf-8"?>
<!--
  سبلاش أندرويد 12+ (API 31+) — إصلاح «شاشة بيضاء فيها شعار أزرق قبل السبلاش»:
  النظام يفرض سبلاش بنفسه عند الإقلاع — نلوّنه أخضر داكناً مثل التطبيق ونستبدل
  الشعار الأجنبي بالهلال الذهبي، فتصبح الانتقالات سلسة بلا أي شاشة بيضاء.
-->
<resources>
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:windowSplashScreenBackground">#043d2c</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
